{
  "name": "@javargasm/opencode-kiro-auth",
  "version": "0.1.2",
  "description": "Kiro provider plugin for OpenCode: AWS Builder ID / Identity Center login and OpenAI compatible local gateway for CodeWhisperer streaming.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javargasm/opencode-kiro-auth.git"
  },
  "homepage": "https://github.com/javargasm/opencode-kiro-auth#readme",
  "bugs": {
    "url": "https://github.com/javargasm/opencode-kiro-auth/issues"
  },
  "keywords": [
    "opencode-package",
    "opencode",
    "plugin",
    "provider",
    "kiro",
    "aws",
    "codewhisperer",
    "amazon-q",
    "claude"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build:js": "bun build src/index.ts --outdir dist --target node --format esm --external '@opencode-ai/*'",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run clean && bun run build:js && bun run build:types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bun": "bun test test/gateway.test.ts",
    "test:watch": "vitest",
    "check": "bun run typecheck && bun run test && bun run test:bun",
    "changeset": "changeset",
    "version": "changeset version",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {},
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.0",
    "@opencode-ai/plugin": "^1.17.3",
    "@types/bun": "latest",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  }
}
